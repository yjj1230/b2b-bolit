# ============================================================================
# b2b_pilot_v3 部署环境变量模板（生产环境使用）
# ----------------------------------------------------------------------------
# 用法：
#   1) 复制本文件为 .env：   cp .env_example .env
#   2) 逐项修改标记为【生产必改】的变量为生产值
#   3) 按需修改【按环境调整】项
#   4) docker compose 启动（compose 通过 ${VAR:-默认值} 读取 .env 做插值）
#
# 注意：.env 含真实凭据，勿提交 git（本模板仅占位，无真实密钥）。
# 生产与测试的核心差异：pgAPI 指向生产库 / 飞书桥接指向生产旧系统 /
#   企微租户 JSON 换生产 / 新客户落库开关关闭 / 上下文密钥显式设置。
# ============================================================================

# ---------------------- HTTP 与基础设施（一般不动） --------------------------
# API 监听地址。compose 默认 :8080，生产一般无需改。
# B2B_HTTP_ADDR=:8080
# PostgreSQL DSN。compose 已用 docker 内部地址（b2b-replica）覆盖，一般无需在 .env 写。
# B2B_PG_DSN=postgres://postgres:postgres@b2b-replica:5432/b2b_pilot?sslmode=disable

# ---------------------- pgAPI（订单数据：客户 / 产品 / 合同） -----------------
# 【生产必改】pgAPI 基址：
#   测试 = https://api.renheng.com/pgapi-test （备库 carh_test；老客户搜索、税号校验数据源）
#   生产 = https://api.renheng.com/pgapi      （生产库 carh；生产环境销售员 open_id 与 pgapi 同应用可对应，
#                                              老客户检索按 open_id 精确匹配，姓名仅作兜底）
B2B_PGAPI_BASE_URL=https://api.renheng.com/pgapi
# 【生产必改】pgAPI 只读 key（生产用真实只读凭据；未配置则跳过税号比对）
B2B_PGAPI_API_KEY=your_pgapi_readonly_key
# 【影子轨专用】影子栈只读 key（HR2）：与 B2B_PGAPI_API_KEY 隔离、禁止写接口，
#   仅 docker-compose.shadow.yml 的 shadow-* 服务读取；A 轨归档写备库仍用 B2B_PGAPI_API_KEY。
B2B_SHADOW_PGAPI_API_KEY=
# pgAPI 超时（秒，默认 10）。
# B2B_PGAPI_TIMEOUT=10

# ---------------------- 新客户落备库 pgAPI（测试特化开关） -------------------
# 【生产必改=关闭】测试=true（新客户下单后 best-effort 直写备库 pgAPI，幂等查重，失败仅记日志）。
#   生产必须 false 或整行删除——生产走「新客户写多维表格 → rhcrm-sync → PG → 老客户读取」原链路，
#   直写会被生产同步软删（权威源=多维表格），因此生产绝不开启。
B2B_PGAPI_ARCHIVE_ENABLED=false

# ---------------------- 企业微信（official 接入） -----------------------------
# 【按环境调整】企微接入方式：official（真实）| mock（演示）。生产 = official。
B2B_WECOM_PROVIDER=official
# 【生产必改】企微租户配置 JSON 源文件路径（compose 挂载为容器内 /etc/b2b/wecom-tenant.json）。
#   该 JSON 含 corp_id / agent_id / secret / token / encoding_aes_key / archive 私钥，
#   生产用新的租户 JSON（不同企业/应用则整体替换）。
B2B_WECOM_TENANT_CFG_FILE=./config/wecom-tenant.json
# 【生产必改】S1 上下文令牌 HMAC 密钥（签发 context_token 用）。
#   生产必须显式设置——未设置会回落到 compose 默认 b2b-dev-context-secret（安全风险）。
B2B_WECOM_CONTEXT_SECRET=replace_with_random_hmac_secret

# ---------------------- Agent 下单 LLM（候选提取） ----------------------------
# LLM 只负责意图理解和字段提取；权限、主数据匹配、确定性校验与审批仍由后端完成。
# 开启前必须确认企微入口和 Agent 灰度范围已配置；未提供 API Key 时 llm provider 会拒绝启动。
B2B_AGENT_ENABLED=false
B2B_WECOM_INGRESS_ENABLED=false
B2B_AGENT_PARSER_PROVIDER=mock
B2B_AGENT_PROMPT_VERSION=v1
B2B_AGENT_LLM_BASE_URL=http://121.40.34.96:18097/v1
B2B_AGENT_LLM_MODEL=gpt-5.6
B2B_AGENT_LLM_TIMEOUT=30
# 【生产必改】通过 Secret Manager 或运行时环境注入，禁止提交真实值。
B2B_AGENT_LLM_API_KEY=<secret-manager-value>

# ---------------------- 飞书三方审批下单桥接（v0.1 桥接） ---------------------
# 【生产必改】桥接总开关：测试=true；生产按发布节奏启用后 = true。
B2B_FEISHU_BRIDGE_ENABLED=true
# 【生产必改】旧系统 tripartite-approval 地址：
#   测试 = https://approval-test.renheng.com
#   生产 = 生产三方审批系统地址（桥接客户端拼 /api/approval/* 与 /external-orders/* 路径）
B2B_FEISHU_BRIDGE_BASE_URL=https://approval.renheng.com
# 【生产必改】旧系统飞书应用 app_id（与旧系统登录用飞书应用一致）。
B2B_FEISHU_BRIDGE_APP_ID=cli_your_production_app_id
# 【生产必改】授权回调地址（v0.1 页面域名 + 回调路径），生产用生产域名。
B2B_FEISHU_BRIDGE_REDIRECT_URI=https://your-prod-domain.renheng.com/wecom/assistant

# ---------------------- 审批人路由 / 身份白名单（ROL-01 收敛） ----------------
# 【按环境调整】审批人路由（默认 u-supervisor/u-chairman/u-op/u-accounting/u-sales，仓库 u-wh-*）。
#   生产如与默认不同，按需覆盖；不覆盖则用代码默认。
# B2B_ASSIGNEE_SUPERVISOR=u-supervisor
# B2B_ASSIGNEE_CHAIRMAN=u-chairman
# B2B_ASSIGNEE_OP=u-op
# B2B_ASSIGNEE_ACCOUNTING=u-accounting
# B2B_ASSIGNEE_SALES=u-sales
# B2B_ASSIGNEE_WAREHOUSE_PREFIX=u-wh-
# B2B_ASSIGNEE_WAREHOUSE_DEFAULT=u-wh-yangyuan
# 【生产必改】严格身份白名单 CSV："userID:ROLE,userID:ROLE"（空=演示角色解析）。
#   生产必须配置真实员工账号，否则按演示模式解析身份。
B2B_V01_PRINCIPALS=
# 【生产必改】严格身份开关：true=只认企微上下文令牌（X-WeCom-Context），无令牌/校验失败一律 401；
#   false=演示/测试模式（保留 X-User-Id 信任，业务流转不变）。测试=false，生产=true。
B2B_AUTH_STRICT=false

# ---------------------- 影子轨 S（内部预演，生产保持关闭） --------------------
# 【生产=保持 false/不设】影子模式开启会启用启动守卫并拉独立影子栈；生产勿开。
# B2B_SHADOW_MODE=false
# 影子轨身份白名单（仅影子环境用）。
# B2B_SHADOW_PRINCIPALS=
# 影子轨 Temporal task queue（A 轨默认 b2b-order；影子轨 b2b-shadow-order）。
# B2B_TASK_QUEUE=b2b-order
# 影子摄入/事件映射/审计输出配置与目录（仅影子环境用）。
# SHADOW_INGEST_CONFIG=config/shadow-ingest.example.json
# SHADOW_FEED_CONFIG=config/shadow-feed.example.json
# SHADOW_REPORT_DIR=logs/audit/shadow

# ---------------------- SpiceDB / Temporal / 企微回调转接（compose 已配） ------
# SpiceDB 地址与 key（compose 默认 spicedb:50051 / b2b-dev-key，一般无需改）。
# B2B_SPICEDB_ADDR=spicedb:50051
# B2B_SPICEDB_KEY=b2b-dev-key
# Temporal 地址与 namespace（compose 默认 temporal:7233 / default，一般无需改）。
# B2B_TEMPORAL_ADDR=temporal:7233
# B2B_TEMPORAL_NS=default
# 企微回调转接目标 API 地址（compose 默认 http://api:8080，一般无需改）。
# B2B_API_ADDR=http://api:8080
