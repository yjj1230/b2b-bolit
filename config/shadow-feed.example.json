{
  "tenant_id": "chang-an-shadow",
  "default_product_id": "recuIusAcXnmue",
  "default_unit_price_cents": 1000,
  "default_payment_term": "款到",
  "default_supplier_channel": "渠道A",
  "rules": [
    {"stage_code": "*", "action": "ORDER_SUBMIT_RECEIVED", "signal": "start",
     "payload_fields": ["order_id", "customer_id", "payment_terms", "product_name", "quantity", "unit_price"],
     "note": "旧系统 submitExternalOrder.ts:1596 落盘：订单请求已持久化（真 event_id/flow_id/stage_code）"},
    {"stage_code": "*", "action": "ORDER_SUBMIT_ACCEPTED", "signal": "start",
     "payload_fields": ["order_id", "customer_id", "payment_terms"],
     "note": "旧系统 submitExternalOrder.ts:1658：订单已保存，进入审批创建"},
    {"stage_code": "*", "action": "TEST_ORDER_CREATED", "signal": "start",
     "payload_fields": ["order_id"], "note": "旧系统测试订单创建状态"},
    {"stage_code": "*", "action": "MANAGER_APPROVED", "signal": "ignore",
     "payload_fields": [], "note": "v0.1 前缀自动确认的信息确认节点；新系统建单即等价，无需信号"},
    {"stage_code": "*", "action": "SUPERVISOR_PENDING", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "SUPERVISOR_APPROVED", "signal": "price-review", "verdict": "APPROVED",
     "payload_fields": ["operator", "reason"], "note": "feishuActionCallback buildOrderDecisionTransition"},
    {"stage_code": "*", "action": "SUPERVISOR_REJECTED", "signal": "price-review", "verdict": "REJECTED",
     "payload_fields": ["operator", "reason"]},
    {"stage_code": "*", "action": "CHAIRMAN_PENDING", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "CHAIRMAN_APPROVED", "signal": "chairman-review", "verdict": "APPROVED",
     "payload_fields": ["operator"]},
    {"stage_code": "*", "action": "CHAIRMAN_REJECTED", "signal": "chairman-review", "verdict": "REJECTED",
     "payload_fields": ["operator"]},
    {"stage_code": "*", "action": "CHAIRMAN_SKIPPED", "signal": "ignore",
     "payload_fields": [], "note": "A/B 级跳过董事长：新系统 ordGradeStep 自动分流"},
    {"stage_code": "*", "action": "CONTRACT_STUB_CREATED", "signal": "ignore",
     "payload_fields": [], "note": "合同在旧系统后台生成；新系统 OrderWorkflow 自动生成合同"},
    {"stage_code": "*", "action": "STOCK_PREPARE_TRIGGER_REQUESTED", "signal": "ignore",
     "payload_fields": [], "note": "终审通过后触发备货；新系统状态机自动进入 STK 段"},
    {"stage_code": "*", "action": "STOCK_PREPARE_CREATED_WAITING", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "STOCK_RESERVATION_APPROVED", "signal": "stock-review", "verdict": "APPROVED",
     "payload_fields": ["operator", "warehouse_id", "note"],
     "note": "旧系统备货预定通过；warehouse 字段名以 T1.3 真实快照为准"},
    {"stage_code": "*", "action": "FINANCE_PAYMENT_PENDING", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "FINANCE_PAYMENT_CONFIRMED", "signal": "payment-confirm", "verdict": "APPROVED",
     "payload_fields": ["operator", "ledger_ref"]},
    {"stage_code": "*", "action": "BUSINESS_WAREHOUSE_PENDING", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "BUSINESS_WAREHOUSE_SUBMITTED", "signal": "warehouse-confirm", "verdict": "APPROVED",
     "payload_fields": ["operator"], "note": "商务提交发货仓：映射为仓管确认通过（差异映射，业务待签字）"},
    {"stage_code": "*", "action": "SHIPMENT_CREATED_WAITING", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "WAREHOUSE_SHIP_PENDING", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "WAREHOUSE_SHIPPED", "signal": "ship-action", "verdict": "SHIP",
     "payload_fields": ["operator", "qty"], "required": ["qty"],
     "note": "实发数量来自发货快照/事件 detail；T1.3 冻结字段名"},
    {"stage_code": "*", "action": "WAREHOUSE_TRANSFERRED", "signal": "ship-action", "verdict": "TRANSFER",
     "payload_fields": ["operator", "warehouse_id"], "required": ["warehouse_id"]},
    {"stage_code": "*", "action": "COMPLETION_EVIDENCE_SUBMITTED", "signal": "receipt-provided",
     "payload_fields": [], "note": "签收回单提交 = 新系统 receipt-provided"},
    {"stage_code": "*", "action": "DELIVERY_COMPLETION_CHECK_PASSED", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "INVOICE_INFO_PENDING", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "DELIVERY_ORDER_ARCHIVED", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "INVOICE_APPLICATION_SUBMITTED", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "AI_INVOICE_MATCH_PASSED", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "FINANCE_ISSUE_APPROVED", "signal": "invoice-issued", "verdict": "ISSUED",
     "payload_fields": ["operator", "tax_no"]},
    {"stage_code": "*", "action": "INVOICE_FILE_UPLOADED", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "INVOICE_PUSHED_TO_SALES", "signal": "ignore", "payload_fields": []},
    {"stage_code": "*", "action": "NO_INVOICE_SALE_HANDLED", "signal": "invoice-issued", "verdict": "NO_NEED",
     "payload_fields": ["operator"]},
    {"stage_code": "*", "action": "COLLECTION_FOLLOWUP_SUBMITTED", "signal": "payment-tracked",
     "payload_fields": ["operator", "amount"], "required": ["amount"],
     "note": "回款登记；amount 字段名以 T1.3 真实快照为准"},
    {"stage_code": "*", "action": "INVOICE_ARCHIVED", "signal": "payment-tracked",
     "payload_fields": ["operator", "amount"], "required": ["amount"],
     "note": "开票归档视为新系统回款跟踪→归档闭合（差异映射，业务待签字）"},
    {"stage_code": "*", "action": "ARCHIVE_EMAIL_CREATED", "signal": "ignore", "payload_fields": []}
  ]
}
